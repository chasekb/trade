# Coinbase API Credentials
# Get these from: https://pro.coinbase.com/profile/api
COINBASE_API_KEY=your_32_character_api_key_here
COINBASE_API_SECRET=your_88_character_base64_secret_here
COINBASE_PASSPHRASE=your_passphrase_here

# System Configuration
OUTPUT_DIR=outputs
LOG_LEVEL=INFO
TRAINED_MODELS_DIR=data/trained_models
ML_TRAINING_BATCH_SIZE=5000

# PostgreSQL host-side published port (the container remains on db:5432).
# The Compose default is 15432; override this when another host port is needed.
POSTGRES_HOST_PORT=15432

# Note: All trading configuration (position sizes, stop loss, take profit, 
# trading fees, product selection, strategy settings, etc.) is configured 
# through the web dashboard's Live Trading tab. These settings are dynamic 
# and can be changed without restarting the application.
