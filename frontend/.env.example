# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Environment
NEXT_PUBLIC_NODE_ENV=development
NEXT_PUBLIC_APP_VERSION=1.0.0

# Bundle Analysis (set to 'true' to enable)
ANALYZE=false

# Optional: External Services (used by backend - not needed by frontend)
# DATABASE_URL=postgresql://user:password@localhost:5432/trading_db
# REDIS_URL=redis://localhost:6379
# QDRANT_URL=http://localhost:6333

# Production URLs (uncomment and modify for production)
# NEXT_PUBLIC_API_URL=https://api.trading-dashboard.com
# NEXT_PUBLIC_WS_URL=wss://ws.trading-dashboard.com
# NEXT_PUBLIC_NODE_ENV=production

# Logging (optional)
# LOG_LEVEL=info
# SENTRY_DSN=your-sentry-dsn-here

# Performance Monitoring (optional)
# VERCEL_ANALYTICS_ID=your-vercel-analytics-id

# CI/CD Variables (for automated deployments)
# GITHUB_SHA=latest-commit-hash
# BUILD_DATE=2025-01-29
