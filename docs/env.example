# Coinbase API Credentials
# Get these from: https://pro.coinbase.com/profile/api
COINBASE_API_KEY=your_32_character_api_key_here
COINBASE_API_SECRET=your_88_character_base64_secret_here
COINBASE_PASSPHRASE=your_passphrase_here

# Core Trading Configuration
# These are basic settings that apply globally
TRADING_PRODUCT_ID=BTC-USD
MAX_POSITION_SIZE=1000.0
STOP_LOSS_PERCENTAGE=0.02
TAKE_PROFIT_PERCENTAGE=0.04
TRADING_FEE_PERCENTAGE=0.001

# System Configuration
OUTPUT_DIR=outputs
LOG_LEVEL=INFO

# Note: Strategy-specific settings (DCA, Buy & Hold, Symbol Limits, etc.)
# are configured through the web dashboard's Strategy Configuration tab
# in the Live Trading section. These settings are dynamic and can be
# changed without restarting the application.
