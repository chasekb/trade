# Coinbase API Credentials
# Get these from: https://pro.coinbase.com/profile/api
COINBASE_API_KEY=your_32_character_api_key_here
COINBASE_API_SECRET=your_88_character_base64_secret_here
COINBASE_PASSPHRASE=your_passphrase_here

# Trading Configuration
TRADING_PRODUCT_ID=BTC-USD
MAX_POSITION_SIZE=1000.0
STOP_LOSS_PERCENTAGE=0.02
TAKE_PROFIT_PERCENTAGE=0.04
TRADING_FEE_PERCENTAGE=0.001

# Symbol Limits
MAX_SYMBOLS_PER_REQUEST=1000
MAX_UNIVERSE_SIZE=500
MAX_POSITIONS_PER_SESSION=100

# Dollar Cost Averaging (DCA) Settings
ENABLE_DCA=false
DCA_AMOUNT=100.0
DCA_FREQUENCY=7
DCA_MAX_INVESTMENTS=52
DCA_START_DELAY=0

# Buy and Hold Settings
ENABLE_BUY_HOLD=false
BUY_HOLD_EXIT_CONDITION=never
BUY_HOLD_PROFIT_TARGET=0.0

# Output Settings
OUTPUT_DIR=outputs
LOG_LEVEL=INFO
